        </Reference>
        <Reference Include="Fusion.Unity">
            <HintPath>$(GorillaTagDir)/Gorilla Tag_Data/Managed/Fusion.Unity.dll</HintPath>
        </Reference>
        <Reference Include="HarmonyXInterop">
            <HintPath>$(GorillaTagDir)/BepInEx/core/HarmonyXInterop.dll</HintPath>
